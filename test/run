#!/bin/bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SANDBOX="$(mktemp -d)"
trap 'rm -rf -- "$SANDBOX"' EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

assert_file() { [[ -f $1 ]] || fail "expected file: $1"; }
assert_absent() { [[ ! -e $1 && ! -L $1 ]] || fail "expected absent: $1"; }
assert_link_to() {
  [[ -L $1 ]] || fail "expected symlink: $1"
  [[ $(readlink -f -- "$1") == $(readlink -f -- "$2") ]] \
    || fail "$1 points outside this checkout"
}

for script in "$ROOT/install.sh" "$ROOT/uninstall.sh" "$ROOT/bin/herdr-drop"; do
  bash -n "$script"
done
jq empty "$ROOT/integrations/shibumi/plugin/manifest.json"
luac -p "$ROOT/hypr/herdr-drop.lua" \
  "$ROOT/hypr/herdr-drop-settings.lua" \
  "$ROOT/integrations/shibumi/herdr-drop-integration.lua"
lua "$ROOT/test/hypr-isolation.lua" "$ROOT/hypr/herdr-drop.lua"
if command -v qmllint >/dev/null 2>&1; then
  qmllint -I /usr/share/omarchy/shell \
    "$ROOT/integrations/shibumi/plugin/BarWidget.qml" >/dev/null 2>&1
  qmllint -I /usr/share/omarchy/shell \
    "$ROOT/integrations/shibumi/plugin/Service.qml" >/dev/null 2>&1
  qmllint -I /usr/share/omarchy/shell \
    "$ROOT/integrations/shibumi/plugin/ThemedConnector.qml" >/dev/null 2>&1
fi
QML_TEST_RUNNER="$(command -v qmltestrunner || true)"
if [[ -z $QML_TEST_RUNNER && -x /usr/lib/qt6/bin/qmltestrunner ]]; then
  QML_TEST_RUNNER=/usr/lib/qt6/bin/qmltestrunner
fi
[[ -n $QML_TEST_RUNNER ]] || fail "qmltestrunner is required for status tests"
QT_QPA_PLATFORM=offscreen "$QML_TEST_RUNNER" \
  -input "$ROOT/test/qml" >/dev/null

HOME_DIR="$SANDBOX/home"
CONFIG_ROOT="$HOME_DIR/.config"
HYPR="$CONFIG_ROOT/hypr"
FAKE_BIN="$SANDBOX/bin"
PLUGIN_ROOT="$CONFIG_ROOT/omarchy/plugins"
SHIBUMI_HOST="$PLUGIN_ROOT/hancore.shibumi.bar"
ACTIVE_THEME="$HOME_DIR/.local/state/omarchy/current/theme"
TEST_LOG="$SANDBOX/commands.log"
mkdir -p "$HYPR" "$FAKE_BIN" "$SHIBUMI_HOST" \
  "$CONFIG_ROOT/herdr" "$ACTIVE_THEME"
printf '%s\n' 'require("default.hypr.omarchy")' >"$HYPR/hyprland.lua"
printf '%s\n' \
  'import QtQuick' \
  'Item {' \
  '  readonly property int shibumiHostContractVersion: 1' \
  '  function publishConnectedPanel() { return true }' \
  '  function clearConnectedPanel() { return true }' \
  '  function requestPopout() { return true }' \
  '  function releasePopout() { return true }' \
  '}' \
  >"$SHIBUMI_HOST/Bar.qml"
printf '%s\n' \
  '{"bar":{"id":"hancore.shibumi.bar","layout":{"left":[],"center":["io.github.lixenstrand.herdr-drop"],"right":[]}}}' \
  >"$CONFIG_ROOT/omarchy/shell.json"

printf '%s\n' \
  '[theme]' \
  'name = "custom"' \
  '' \
  '[theme.custom]' \
  'panel_bg = "#000000"' \
  'text = "#ffffff"' \
  'accent = "#ffffff"' \
  'selection_bg = "#222222"' \
  'red = "#ff0000"' \
  'green = "#00ff00"' \
  'yellow = "#ffff00"' \
  'blue = "#0000ff"' >"$CONFIG_ROOT/herdr/config.toml"
printf '%s\n' \
  'background = "#2d353b"' \
  'foreground = "#d3c6aa"' \
  'accent = "#7fbbb3"' \
  'selection = "#3d484d"' \
  'selection_background = "#3d484d"' \
  'red = "#e67e80"' \
  'green = "#a7c080"' \
  'yellow = "#dbbc7f"' \
  'blue = "#7fbbb3"' >"$ACTIVE_THEME/colors.toml"
printf '%s\n' \
  '[hyprland]' \
  'active-border = "#7fbbb3"' \
  '' \
  '[popups]' \
  'background = "#2d353b"' \
  'border = "hyprland.active-border"' >"$ACTIVE_THEME/shell.toml"
printf '%s\n' \
  '[theme.custom]' \
  'panel_bg = "#2d353b"' \
  'text = "#d3c6aa"' \
  'accent = "#7fbbb3"' \
  'selection_bg = "#3d484d"' \
  'red = "#e67e80"' \
  'green = "#a7c080"' \
  'yellow = "#dbbc7f"' \
  'blue = "#7fbbb3"' >"$ACTIVE_THEME/herdr.toml"

for command_name in herdr omarchy-launch-tui socat; do
  printf '%s\n' '#!/bin/sh' 'exit 0' >"$FAKE_BIN/$command_name"
  chmod 755 "$FAKE_BIN/$command_name"
done
printf '%s\n' \
  '#!/bin/sh' \
  'printf '\''hyprctl %s\n'\'' "$*" >>"${TEST_LOG:?}"' \
  'case "$*" in' \
  '  "configerrors") exit 0 ;;' \
  '  "-j binds") printf '\''%s\n'\'' '\''[{"description":"Herdr drop-down"}]'\'' ;;' \
  '  "-j clients") printf '\''%s\n'\'' '\''[]'\'' ;;' \
  '  "-j monitors") printf '\''%s\n'\'' "${HYPR_MONITORS_JSON:-[]}" ;;' \
  '  eval*) printf '\''%s\n'\'' '\''ok'\'' ;;' \
  '  *) printf '\''%s\n'\'' '\''ok'\'' ;;' \
  'esac' >"$FAKE_BIN/hyprctl"
chmod 755 "$FAKE_BIN/hyprctl"
printf '%s\n' \
  '#!/bin/sh' \
  'printf '\''omarchy %s\n'\'' "$*" >>"${TEST_LOG:?}"' \
  'case "$*" in' \
  '  "menu keybindings --print") printf '\''%s\n'\'' '\''SUPER + A → Existing action'\'' ;;' \
  '  *) exit 0 ;;' \
  'esac' >"$FAKE_BIN/omarchy"
chmod 755 "$FAKE_BIN/omarchy"
printf '%s\n' \
  '#!/bin/sh' \
  'printf '\''omarchy-shell %s\n'\'' "$*" >>"${TEST_LOG:?}"' \
  'case "$*" in' \
  '  "shibumi-suite connectedPanelState") printf '\''%s\n'\'' '\''{"active":false,"screen":"","x":0,"reveal":0}'\'' ;;' \
  '  "io.github.lixenstrand.herdr-drop state") printf '\''%s\n'\'' '\''{"visible":false,"hasBar":true,"hostCompatible":true,"hostContractVersion":1,"connector":{"visible":false,"hasScreen":false,"surface":"#2d353b","stroke":"#7fbbb3"},"events":{"connected":true,"count":1,"fallbackPollMs":60000}}'\'' ;;' \
  '  *) printf '\''%s\n'\'' '\''ok'\'' ;;' \
  'esac' >"$FAKE_BIN/omarchy-shell"
chmod 755 "$FAKE_BIN/omarchy-shell"
ln -s "$(command -v jq)" "$FAKE_BIN/jq"

export HERDR_DROP_HOME="$HOME_DIR"
export XDG_CONFIG_HOME="$CONFIG_ROOT"
export TEST_LOG
export PATH="$FAKE_BIN:/usr/bin:/bin"

"$ROOT/install.sh" --focus-title "Mission Control" --no-reload >/dev/null

assert_link_to "$HOME_DIR/.local/bin/herdr-drop" "$ROOT/bin/herdr-drop"
assert_link_to "$HYPR/herdr-drop.lua" "$ROOT/hypr/herdr-drop.lua"
assert_file "$HYPR/herdr-drop-settings.lua"
assert_file "$CONFIG_ROOT/herdr-drop/config"
rg -q 'width = 0.82' "$HYPR/herdr-drop-settings.lua" \
  || fail "v1.1 width default was not installed"
rg -q 'height = 0.68' "$HYPR/herdr-drop-settings.lua" \
  || fail "v1.1 height default was not installed"
rg -q 'rounding = 12' "$HYPR/herdr-drop-settings.lua" \
  || fail "v1.1 rounding default was not installed"
rg -q 'animation_speed = false' "$HYPR/herdr-drop-settings.lua" \
  || fail "v1.1 changed special-workspace animation globally"
[[ $(<"$CONFIG_ROOT/herdr-drop/config") == "Mission Control" ]] \
  || fail "focus title was not stored as plain text"
HYPR_MONITORS_JSON='[{"id":1,"name":"DP-1","focused":false,"specialWorkspace":{"name":"special:herdrdrop"}},{"id":2,"name":"DP-2","focused":true,"specialWorkspace":{"name":""}}]'
export HYPR_MONITORS_JSON
: >"$TEST_LOG"
"$HOME_DIR/.local/bin/herdr-drop" hide
rg -Fq 'hyprctl eval local monitor = hl.get_monitor("DP-1"); if monitor then monitor:set_special_workspace({}) end' \
  "$TEST_LOG" || fail "hide did not close Herdr Drop through its owning monitor"
if rg -Fq 'workspace.toggle_special' "$TEST_LOG"; then
  fail "hide toggled Herdr Drop on the focused monitor"
fi
HYPR_MONITORS_JSON='[]'
[[ $(grep -cF 'require("hypr.herdr-drop")' "$HYPR/hyprland.lua") == 1 ]] \
  || fail "Hyprland require was not installed exactly once"
assert_link_to "$CONFIG_ROOT/omarchy/themed/herdr-drop.toml.tpl" \
  "$ROOT/integrations/omarchy/themed/herdr.toml.tpl"
assert_link_to "$CONFIG_ROOT/omarchy/hooks/theme-set.d/herdr-drop-theme" \
  "$ROOT/integrations/omarchy/hooks/herdr-theme"
rg -Fq 'panel_bg = "#2d353b"' "$CONFIG_ROOT/herdr/config.toml" \
  || fail "installer did not apply the current Omarchy palette to Herdr"
valid_config="$(<"$CONFIG_ROOT/herdr/config.toml")"
printf '%s\n' "$valid_config" '# >>> omarchy-theme' \
  'panel_bg = "#000000"' >"$CONFIG_ROOT/herdr/config.toml"
malformed_before="$(sha256sum "$CONFIG_ROOT/herdr/config.toml")"
if HOME="$HOME_DIR" HERDR_CONFIG="$CONFIG_ROOT/herdr/config.toml" \
  OMARCHY_THEME_DIR="$ACTIVE_THEME" \
  "$ROOT/integrations/omarchy/hooks/herdr-theme" >/dev/null 2>&1; then
  fail "theme hook accepted a malformed marker block"
fi
[[ $(sha256sum "$CONFIG_ROOT/herdr/config.toml") == "$malformed_before" ]] \
  || fail "theme hook changed a config with malformed markers"
printf '%s' "$valid_config" >"$CONFIG_ROOT/herdr/config.toml"
"$HOME_DIR/.local/bin/herdr-drop" doctor >/dev/null \
  || fail "doctor rejected a healthy installation"
[[ $("$HOME_DIR/.local/bin/herdr-drop" version) == "herdr-drop 1.6.4" ]] \
  || fail "version command returned the wrong version"
mv "$HYPR/herdr-drop-settings.lua" "$HYPR/herdr-drop-settings.lua.missing"
if "$HOME_DIR/.local/bin/herdr-drop" doctor >/dev/null 2>&1; then
  fail "doctor accepted an installation with missing settings"
fi
mv "$HYPR/herdr-drop-settings.lua.missing" "$HYPR/herdr-drop-settings.lua"

printf '%s\n' 'return { key = "SUPER + H" }' >"$HYPR/herdr-drop-settings.lua"
"$ROOT/install.sh" --focus-title "Mission Control" --no-reload >/dev/null
[[ $(<"$HYPR/herdr-drop-settings.lua") == 'return { key = "SUPER + H" }' ]] \
  || fail "rerun overwrote user settings"
backup_count="$(find "$CONFIG_ROOT/herdr-drop" -maxdepth 1 -name 'config.bak.*' | wc -l)"
[[ $backup_count == 0 ]] || fail "idempotent rerun created a redundant backup"

cp "$SHIBUMI_HOST/Bar.qml" "$SHIBUMI_HOST/Bar.qml.compatible"
sed 's/shibumiHostContractVersion: 1/shibumiHostContractVersion: 0/' \
  "$SHIBUMI_HOST/Bar.qml.compatible" >"$SHIBUMI_HOST/Bar.qml"
if "$ROOT/install.sh" --shibumi --no-reload >/dev/null 2>&1; then
  fail "installer accepted an incompatible Shibumi host contract"
fi
mv "$SHIBUMI_HOST/Bar.qml.compatible" "$SHIBUMI_HOST/Bar.qml"

"$ROOT/install.sh" --shibumi-style --no-reload >/dev/null
assert_link_to "$HYPR/herdr-drop-integration.lua" \
  "$ROOT/integrations/shibumi/herdr-drop-integration.lua"
assert_absent "$PLUGIN_ROOT/io.github.lixenstrand.herdr-drop"

"$ROOT/install.sh" --shibumi --no-reload >/dev/null
assert_file "$PLUGIN_ROOT/io.github.lixenstrand.herdr-drop/manifest.json"
assert_file "$PLUGIN_ROOT/io.github.lixenstrand.herdr-drop/.herdr-drop-owned"
cmp -s "$PLUGIN_ROOT/io.github.lixenstrand.herdr-drop/BarWidget.qml" \
  "$ROOT/integrations/shibumi/plugin/BarWidget.qml" \
  || fail "installed Shibumi widget differs from this checkout"
cmp -s "$PLUGIN_ROOT/io.github.lixenstrand.herdr-drop/Service.qml" \
  "$ROOT/integrations/shibumi/plugin/Service.qml" \
  || fail "installed Shibumi connector differs from this checkout"
cmp -s "$PLUGIN_ROOT/io.github.lixenstrand.herdr-drop/Status.js" \
  "$ROOT/integrations/shibumi/plugin/Status.js" \
  || fail "installed Shibumi status logic differs from this checkout"
cmp -s "$PLUGIN_ROOT/io.github.lixenstrand.herdr-drop/ThemedConnector.qml" \
  "$ROOT/integrations/shibumi/plugin/ThemedConnector.qml" \
  || fail "installed themed connector differs from this checkout"
rg -Fq 'if (!panelVisible || connectionReveal <= 0.001)' \
  "$ROOT/integrations/shibumi/plugin/Service.qml" \
  || fail "connector is not cleared when panel closing begins"
rg -Fq 'hostCaret: false' \
  "$ROOT/integrations/shibumi/plugin/Service.qml" \
  && rg -Fq 'Commons.Color.popups.background' \
    "$ROOT/integrations/shibumi/plugin/ThemedConnector.qml" \
  && rg -Fq 'Commons.Color.popups.border' \
    "$ROOT/integrations/shibumi/plugin/ThemedConnector.qml" \
  || fail "connector does not follow the active Omarchy popup theme"
rg -Fq 'if (root.panelVisible) root.beginClosing()' \
  "$ROOT/integrations/shibumi/plugin/Service.qml" \
  || fail "bar toggle does not hide its connector before closing"
rg -Fq 'text: "󰳆"' \
  "$ROOT/integrations/shibumi/plugin/BarWidget.qml" \
  || fail "Shibumi widget does not use the Herdr sheep icon"
rg -Fq 'id: openingMotion' \
  "$ROOT/integrations/shibumi/plugin/BarWidget.qml" \
  && rg -Fq 'id: closingMotion' \
    "$ROOT/integrations/shibumi/plugin/BarWidget.qml" \
  || fail "sheep motion does not cover both opening and closing"
rg -Fq 'active: root.opened || root.hasWorkingAgents' \
  "$ROOT/integrations/shibumi/plugin/BarWidget.qml" \
  && rg -Fq 'visible: root.statusBadge === "done"' \
    "$ROOT/integrations/shibumi/plugin/BarWidget.qml" \
  && rg -Fq 'visible: root.statusBadge === "blocked"' \
    "$ROOT/integrations/shibumi/plugin/BarWidget.qml" \
  || fail "sheep icon does not expose live agent state"
rg -Fq 'command: ["herdr", "api", "snapshot"]' \
  "$ROOT/integrations/shibumi/plugin/Service.qml" \
  && rg -Fq 'Väntar på dig' \
    "$ROOT/integrations/shibumi/plugin/Status.js" \
  && rg -Fq 'terminal_title_stripped' \
    "$ROOT/integrations/shibumi/plugin/Status.js" \
  || fail "hover status is not backed by concrete Herdr data"
rg -Fq 'method: "events.subscribe"' \
  "$ROOT/integrations/shibumi/plugin/Service.qml" \
  && rg -Fq 'interval: root.herdrEventsConnected ? 60000 : 15000' \
    "$ROOT/integrations/shibumi/plugin/Service.qml" \
  && rg -Fq 'interval: 30000' \
    "$ROOT/integrations/shibumi/plugin/Service.qml" \
  || fail "Shibumi service still relies on frequent background polling"
rg -Fq 'root.setting("privacyMode", false)' \
  "$ROOT/integrations/shibumi/plugin/BarWidget.qml" \
  || fail "Shibumi widget does not expose privacy mode"
rg -Fq 'omarchy-shell -q "$SHIBUMI_WIDGET_ID" beginClose' \
  "$ROOT/bin/herdr-drop" \
  || fail "keybinding does not hide its connector before closing"
"$ROOT/install.sh" --shibumi --no-reload >/dev/null
if compgen -G "$CONFIG_ROOT/herdr-drop/backups/shibumi-plugin.*" >/dev/null; then
  fail "idempotent Shibumi rerun created a redundant backup"
fi
assert_link_to "$HYPR/herdr-drop-integration.lua" \
  "$ROOT/integrations/shibumi/herdr-drop-integration.lua"
rg -q 'animation_speed = 4' "$HYPR/herdr-drop-integration.lua" \
  || fail "Shibumi profile did not enable the connected-panel animation"
rg -q 'leaf = "specialWorkspaceIn"' "$HYPR/herdr-drop.lua" \
  && rg -q 'style = "slidefadevert top"' "$HYPR/herdr-drop.lua" \
  || fail "Herdr Drop does not enter from the top edge"
rg -q 'leaf = "specialWorkspaceOut"' "$HYPR/herdr-drop.lua" \
  && rg -A2 'leaf = "specialWorkspaceOut"' "$HYPR/herdr-drop.lua" \
    | rg -q 'enabled = false' \
  || fail "Herdr Drop closing animation is enabled"
rg -q '^omarchy-shell shell rescanPlugins$' "$TEST_LOG" \
  || fail "idempotent Shibumi install did not rescan plugins"
rg -q '^omarchy restart shell$' "$TEST_LOG" \
  || fail "changed Shibumi service did not restart the shell"
rg -q '^omarchy bar put io.github.lixenstrand.herdr-drop --section center$' \
  "$TEST_LOG" || fail "Shibumi install did not place the bar widget"
"$HOME_DIR/.local/bin/herdr-drop" doctor >/dev/null \
  || fail "doctor rejected a healthy Shibumi integration"

restart_count_before_uninstall="$(grep -c '^omarchy restart shell$' "$TEST_LOG")"
"$ROOT/uninstall.sh" --no-reload >/dev/null
assert_absent "$HOME_DIR/.local/bin/herdr-drop"
assert_absent "$HYPR/herdr-drop.lua"
assert_absent "$PLUGIN_ROOT/io.github.lixenstrand.herdr-drop"
assert_absent "$HYPR/herdr-drop-integration.lua"
assert_absent "$CONFIG_ROOT/omarchy/themed/herdr-drop.toml.tpl"
assert_absent "$CONFIG_ROOT/omarchy/hooks/theme-set.d/herdr-drop-theme"
assert_file "$HYPR/herdr-drop-settings.lua"
assert_file "$CONFIG_ROOT/herdr-drop/config"
rg -q '^omarchy plugin disable io.github.lixenstrand.herdr-drop$' "$TEST_LOG" \
  || fail "uninstaller did not disable the Shibumi widget"
restart_count_after_uninstall="$(grep -c '^omarchy restart shell$' "$TEST_LOG")"
(( restart_count_after_uninstall > restart_count_before_uninstall )) \
  || fail "uninstaller did not restart Omarchy Shell after plugin removal"
! grep -qF 'require("hypr.herdr-drop")' "$HYPR/hyprland.lua" \
  || fail "uninstaller left the Hyprland require behind"

"$ROOT/install.sh" --focus-title "Mission Control" --no-reload >/dev/null
"$ROOT/uninstall.sh" --purge --no-reload >/dev/null
assert_absent "$HYPR/herdr-drop-settings.lua"
assert_absent "$CONFIG_ROOT/herdr-drop/config"
compgen -G "$HYPR/herdr-drop-settings.lua.bak.*" >/dev/null \
  || fail "purge did not preserve a settings backup"
compgen -G "$CONFIG_ROOT/herdr-drop/config.bak.*" >/dev/null \
  || fail "purge did not preserve a title backup"

printf 'PASS: Herdr Drop v1.6.4 window/layer dismissal, outside-click dismissal, theme sync, events, contract checks, install, doctor, uninstall, and purge\n'
