#!/bin/bash
# A persistent Herdr client in a drop-down Hyprland special workspace.

set -uo pipefail

VERSION="1.3.0"
APP_ID="org.omarchy.herdrdrop"
SPECIAL="herdrdrop"
USER_HOME="${HERDR_DROP_HOME:-$HOME}"
CONFIG_ROOT="${XDG_CONFIG_HOME:-$USER_HOME/.config}"
CONFIG="$CONFIG_ROOT/herdr-drop/config"
HYPR="$CONFIG_ROOT/hypr"
HYPRLAND="$HYPR/hyprland.lua"
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
PLUGIN_ROOT="$CONFIG_ROOT/omarchy/plugins"
SHELL_CONFIG="$CONFIG_ROOT/omarchy/shell.json"
SHIBUMI_BAR_ID="hancore.shibumi.bar"
SHIBUMI_WIDGET_ID="io.github.lixenstrand.herdr-drop"
SHIBUMI_PLUGIN="$PLUGIN_ROOT/$SHIBUMI_WIDGET_ID"
SHIBUMI_PROFILE="$HYPR/herdr-drop-integration.lua"

# The config is user-owned plain text. Keeping a machine-specific title
# outside this script makes the drop-down reusable without executing config.
FOCUS_TITLE=""
if [[ -f $CONFIG ]]; then
  IFS= read -r FOCUS_TITLE <"$CONFIG" || true
fi

window_exists() {
  hyprctl -j clients 2>/dev/null \
    | jq -e --arg class "$APP_ID" 'any(.[]; .class == $class)' >/dev/null 2>&1
}

# Omarchy's Lua dispatcher does not accept the old Hyprland dispatcher syntax.
# Report failures instead of turning the keybinding into a silent no-op.
toggle_special() {
  local response
  response="$(hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$SPECIAL\")" 2>&1)"
  [[ $response == ok ]] && return 0
  notify-send "Herdr Drop" "Could not toggle special:$SPECIAL — $response" 2>/dev/null
  return 1
}

special_visible() {
  hyprctl -j monitors 2>/dev/null \
    | jq -e --arg workspace "special:$SPECIAL" \
      'any(.[]; .specialWorkspace.name == $workspace)' >/dev/null 2>&1
}

hide_connector() {
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  [[ -e $SHIBUMI_PLUGIN || -L $SHIBUMI_PROFILE ]] || return 0
  omarchy-shell -q "$SHIBUMI_WIDGET_ID" beginClose
}

show_window() { special_visible || toggle_special; }
hide_window() {
  if special_visible; then
    hide_connector
    toggle_special
  fi
}

# Opening a second Herdr client on top of an already focused Herdr window adds
# no information. The dedicated drop-down window itself is excluded so the
# same key always remains able to hide it.
on_herdr() {
  local info class title
  info="$(hyprctl -j activewindow 2>/dev/null)"
  class="$(jq -r '.class // empty' <<<"$info")"
  title="$(jq -r '.title // empty' <<<"$info")"
  [[ $class == "$APP_ID" ]] && return 1
  [[ $class == "org.omarchy.herdr" ]] && return 0
  [[ $title =~ ^omarchy:\ \[ ]]
}

# Focus is changed only before the drop-down client is created. Later toggles
# preserve wherever the user navigated inside Herdr.
focus_target() {
  local workspace
  [[ -n $FOCUS_TITLE ]] || return 0
  workspace="$(herdr pane list 2>/dev/null | jq -r --arg title "$FOCUS_TITLE" '
    first(.result.panes[]?
      | select((.terminal_title_stripped // "") | contains($title))
      | .workspace_id) // empty
  ' 2>/dev/null)"
  [[ -n ${workspace:-} ]] || return 0
  herdr workspace focus "$workspace" >/dev/null 2>&1
}

# The window rule creates the client hidden. Wait for the actual window before
# revealing the special workspace so the first keypress never shows an empty
# panel.
launch_window() {
  focus_target
  omarchy-launch-tui --app-id="$APP_ID" herdr >/dev/null 2>&1 &
  for _ in $(seq 1 40); do
    window_exists && return 0
    sleep 0.25
  done
  notify-send "Herdr Drop" "The Herdr window did not start within 10 seconds" 2>/dev/null
  return 1
}

doctor() {
  local failures=0 missing=() errors bind_count clients
  local integration_present=0 connector_state connector_service_state
  local connected=0 active_bar

  pass() { printf 'PASS  %s\n' "$*"; }
  info() { printf 'INFO  %s\n' "$*"; }
  fail() { printf 'FAIL  %s\n' "$*"; failures=$((failures + 1)); }

  printf 'Herdr Drop doctor %s\n' "$VERSION"

  local command_name
  for command_name in herdr jq hyprctl omarchy omarchy-launch-tui; do
    command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
  done
  if (( ${#missing[@]} == 0 )); then
    pass "Required commands are available"
  else
    fail "Missing commands: ${missing[*]}"
  fi

  if [[ -L $USER_HOME/.local/bin/herdr-drop ]] \
    && [[ $(readlink -f -- "$USER_HOME/.local/bin/herdr-drop") == "$SCRIPT_PATH" ]]; then
    pass "Command link belongs to this checkout"
  else
    fail "Command link is missing or points elsewhere: $USER_HOME/.local/bin/herdr-drop"
  fi

  if [[ -L $HYPR/herdr-drop.lua ]] \
    && [[ $(readlink -f -- "$HYPR/herdr-drop.lua") == "$REPO_ROOT/hypr/herdr-drop.lua" ]]; then
    pass "Hyprland module belongs to this checkout"
  else
    fail "Hyprland module is missing or points elsewhere: $HYPR/herdr-drop.lua"
  fi

  if [[ -f $HYPRLAND ]] && grep -qF 'require("hypr.herdr-drop")' "$HYPRLAND"; then
    pass "Hyprland loads Herdr Drop"
  else
    fail "Hyprland does not load Herdr Drop"
  fi

  if [[ -f $HYPR/herdr-drop-settings.lua ]]; then
    pass "User settings exist"
  else
    fail "User settings are missing: $HYPR/herdr-drop-settings.lua"
  fi

  if [[ -e $SHIBUMI_PLUGIN || -L $SHIBUMI_PLUGIN \
    || -e $SHIBUMI_PROFILE || -L $SHIBUMI_PROFILE ]]; then
    integration_present=1
  fi

  if (( integration_present )); then
    if ! command -v omarchy-shell >/dev/null 2>&1; then
      fail "Missing Shibumi integration command: omarchy-shell"
    else
      connector_service_state="$(omarchy-shell "$SHIBUMI_WIDGET_ID" state 2>/dev/null || true)"
      if jq -e '.hasBar == true' <<<"$connector_service_state" >/dev/null 2>&1; then
        pass "Shibumi connector service is active"
      else
        fail "Shibumi connector service is not active"
      fi
    fi

    if [[ -d $SHIBUMI_PLUGIN && ! -L $SHIBUMI_PLUGIN ]] \
      && [[ -f $SHIBUMI_PLUGIN/.herdr-drop-owned ]] \
      && grep -qFx -- "$SHIBUMI_WIDGET_ID" "$SHIBUMI_PLUGIN/.herdr-drop-owned" \
      && cmp -s -- "$SHIBUMI_PLUGIN/manifest.json" "$REPO_ROOT/integrations/shibumi/plugin/manifest.json" \
      && cmp -s -- "$SHIBUMI_PLUGIN/BarWidget.qml" "$REPO_ROOT/integrations/shibumi/plugin/BarWidget.qml" \
      && cmp -s -- "$SHIBUMI_PLUGIN/Service.qml" "$REPO_ROOT/integrations/shibumi/plugin/Service.qml"; then
      pass "Shibumi widget files match this checkout"
    else
      fail "Shibumi widget is missing or differs from this checkout: $SHIBUMI_PLUGIN"
    fi

    if [[ -L $SHIBUMI_PROFILE ]] \
      && [[ $(readlink -f -- "$SHIBUMI_PROFILE") == "$REPO_ROOT/integrations/shibumi/herdr-drop-integration.lua" ]]; then
      pass "Shibumi geometry profile belongs to this checkout"
    else
      fail "Shibumi geometry profile is missing or points elsewhere: $SHIBUMI_PROFILE"
    fi

    if [[ -f $SHELL_CONFIG ]]; then
      active_bar="$(jq -r '.bar.id // "omarchy.bar"' "$SHELL_CONFIG" 2>/dev/null)"
      if [[ $active_bar == "$SHIBUMI_BAR_ID" ]]; then
        pass "Shibumi is the active bar"
      else
        fail "Shibumi integration is installed but the active bar is $active_bar"
      fi

      if jq -e --arg id "$SHIBUMI_WIDGET_ID" '
        [((.bar.layout.left // []) + (.bar.layout.center // [])
          + (.bar.layout.right // []))[]
          | if type == "object" then .id else . end]
        | index($id) != null
      ' "$SHELL_CONFIG" >/dev/null 2>&1; then
        pass "Herdr widget is on the bar"
      else
        fail "Herdr widget is not present in the bar layout"
      fi
    else
      fail "Omarchy shell configuration is missing: $SHELL_CONFIG"
    fi

    if special_visible && command -v omarchy-shell >/dev/null 2>&1; then
      for _ in $(seq 1 10); do
        connector_state="$(omarchy-shell shibumi-suite connectedPanelState 2>/dev/null || true)"
        if jq -e '.active == true and (.screen | length > 0)
          and (.reveal > 0.99)' <<<"$connector_state" >/dev/null 2>&1; then
          connected=1
          break
        fi
        sleep 0.1
      done
      if (( connected )); then
        pass "Visible panel is connected to the bar"
      else
        fail "Panel is visible but the Shibumi connector is inactive"
      fi
    else
      info "Shibumi connector is ready; open the panel to exercise it"
    fi
  fi

  if command -v hyprctl >/dev/null 2>&1; then
    if errors="$(hyprctl configerrors 2>&1)"; then
      if [[ -z $errors ]]; then
        pass "Hyprland reports no configuration errors"
      else
        fail "Hyprland configuration errors: $errors"
      fi
    else
      fail "Could not query Hyprland configuration errors: $errors"
    fi

    if command -v jq >/dev/null 2>&1; then
      bind_count="$(hyprctl -j binds 2>/dev/null \
        | jq '[.[] | select(.description == "Herdr drop-down")] | length' 2>/dev/null)"
      if [[ ${bind_count:-0} -gt 0 ]]; then
        pass "Herdr Drop keybinding is active"
      else
        fail "Herdr Drop keybinding is not active"
      fi

      clients="$(hyprctl -j clients 2>/dev/null)"
      if jq -e --arg class "$APP_ID" 'any(.[]; .class == $class)' \
        <<<"$clients" >/dev/null 2>&1; then
        info "Panel client is running"
      else
        info "Panel client is not running; it will start on first open"
      fi
    fi
  fi

  if (( failures == 0 )); then
    printf 'OK    Herdr Drop is healthy\n'
    return 0
  fi

  printf 'ERROR %d check(s) failed\n' "$failures" >&2
  return 1
}

case "${1:-toggle}" in
toggle)
  if special_visible; then
    hide_window
  elif on_herdr; then
    : # A normal Herdr window is already visible.
  elif window_exists; then
    show_window
  else
    launch_window && show_window
  fi
  ;;
open)
  window_exists || launch_window
  show_window
  ;;
hide) hide_window ;;
doctor) doctor ;;
version | -V | --version) printf 'herdr-drop %s\n' "$VERSION" ;;
kill)
  # Close only the client. Herdr's server and agent sessions keep running.
  hyprctl -j clients 2>/dev/null \
    | jq -r --arg class "$APP_ID" \
      'first(.[] | select(.class == $class) | .address) // empty' \
    | while read -r address; do
        [[ -n $address ]] || continue
        hyprctl dispatch \
          "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null
      done
  ;;
-h | --help | help)
  cat <<'USAGE'
herdr-drop — persistent Herdr client in a drop-down panel

  toggle   Show or hide the panel (default)
  open     Always show the panel
  hide     Hide the panel
  kill     Close the panel client; Herdr sessions keep running
  doctor   Check dependencies, installation, keybinding, and Hyprland
  version  Print the installed Herdr Drop version

Put a pane-title fragment in ~/.config/herdr-drop/config to focus that pane
when the panel client is first created.
USAGE
  ;;
*)
  printf 'Unknown command: %s\n' "$1" >&2
  exit 1
  ;;
esac
